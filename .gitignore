# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next
/out/

# production
/build

# misc
.DS_Store
*.pem
IDEAS.md
IMPROVEMENTS.md
TODOS.md
FEATURE-WORK.md
COMMANDS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Disposable Codex captures and generated audit evidence (keep reference assets tracked)
/artifacts/codex-screenshots/
/artifacts/generated-audits/
/artifacts/audit-*.json
/artifacts/dependency-chains-initial.json
/artifacts/security-*.log
/artifacts/security-dependency-diff.json
/artifacts/security-runtime-smoke.json
/artifacts/security-test-results.json

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
*.pyc
__pycache__/